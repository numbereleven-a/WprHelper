<Window x:Class="WprHelper.App.ProfileNameDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{DynamicResource RenameProfile}" Width="430" SizeToContent="Height" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource WindowBackground}">
 <StackPanel Margin="20">
  <TextBlock Text="{DynamicResource NewProfileName}" Style="{StaticResource LabelStyle}"/>
  <TextBox x:Name="NameBox" Margin="0,0,0,18"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="{DynamicResource RenameProfile}" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="AcceptClick"/>
   <Button Content="{DynamicResource Cancel}" Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="0"/>
  </StackPanel>
 </StackPanel>
</Window>
